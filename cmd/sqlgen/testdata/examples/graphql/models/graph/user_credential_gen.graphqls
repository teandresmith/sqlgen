"""
UserCredential corresponds to the user_credentials table.
"""
type UserCredential {
  "user_id"
  userID: UUID!
  "provider"
  provider: String!
  "external_id"
  externalID: String!
  "last_login_at"
  lastLoginAt: Time
  "created_at"
  createdAt: Time!
  "one-to-one relationship with the users table."
  users: User
}

type UserCredentialConnection {
  edges:      [UserCredentialEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type UserCredentialEdge {
  node:   UserCredential!
  cursor: String!
}

type UserCredentialListResult {
  items:      [UserCredential!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input UserCredentialFilter {
  provider: StringComparator
  externalID: StringComparator
  lastLoginAt: NullableTimeComparator
  createdAt: TimeComparator
  and: [UserCredentialFilter!]
  or:  [UserCredentialFilter!]
}

enum UserCredentialSortField {
  USER_ID
  PROVIDER
  EXTERNAL_ID
  LAST_LOGIN_AT
  CREATED_AT
}

input UserCredentialSort {
  field:     UserCredentialSortField!
  direction: SortDirection!
}
input CreateUserCredentialInput {
  userID: UUID!
  provider: String!
  externalID: String!
  lastLoginAt: Time
  createdAt: Time!
}
input UpdateUserCredentialInput {
  provider: String
  externalID: String
  lastLoginAt: Time
  createdAt: Time
}

extend type Query {
  userCredential(userID: UUID!): UserCredential
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to userCredentialList instead."
  userCredentials(filter: UserCredentialFilter, first: Int, after: String, last: Int, before: String): UserCredentialConnection!
  userCredentialList(filter: UserCredentialFilter, sort: [UserCredentialSort!], limit: Int, offset: Int): UserCredentialListResult!
}

extend type Mutation {
  createUserCredential(input: CreateUserCredentialInput!): UserCredential!
  createUserCredentials(inputs: [CreateUserCredentialInput!]!): [UserCredential!]!
  updateUserCredential(userID: UUID!, input: UpdateUserCredentialInput!): UserCredential!
  updateUserCredentials(filter: UserCredentialFilter!, input: UpdateUserCredentialInput!): [UserCredential!]!
  upsertUserCredential(input: CreateUserCredentialInput!): UserCredential!
  deleteUserCredential(userID: UUID!): Boolean!
}
