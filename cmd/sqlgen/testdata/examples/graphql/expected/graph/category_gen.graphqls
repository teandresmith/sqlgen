"""
Product classification categories
"""
type Category {
  "id"
  id: Int!
  "Unique category display name"
  name: String!
  "Optional long-form description"
  description: String
  "created_at"
  createdAt: Time!
  "one-to-many relationship with the products table."
  products: [Product!]!
  "many-to-many relationship with the users table."
  users: [User!]!
}

type CategoryConnection {
  edges:      [CategoryEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type CategoryEdge {
  node:   Category!
  cursor: String!
}

type CategoryListResult {
  items:      [Category!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input CategoryFilter {
  name: StringComparator
  description: NullableStringComparator
  createdAt: TimeComparator
  products: ProductFilter
  users: UserFilter
  and: [CategoryFilter!]
  or:  [CategoryFilter!]
}

enum CategorySortField {
  ID
  NAME
  DESCRIPTION
  CREATED_AT
}

input CategorySort {
  field:     CategorySortField!
  direction: SortDirection!
}
input CreateCategoryInput {
  name: String!
  description: String
  createdAt: Time!
}
input UpdateCategoryInput {
  name: String
  description: String
  createdAt: Time
}

extend type Query {
  category(id: Int!): Category
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to categoryList instead."
  categories(filter: CategoryFilter, first: Int, after: String, last: Int, before: String): CategoryConnection!
  categoryList(filter: CategoryFilter, sort: [CategorySort!], limit: Int, offset: Int): CategoryListResult!
}

extend type Mutation {
  createCategory(input: CreateCategoryInput!): Category!
  createCategories(inputs: [CreateCategoryInput!]!): [Category!]!
  updateCategory(id: Int!, input: UpdateCategoryInput!): Category!
  updateCategories(filter: CategoryFilter!, input: UpdateCategoryInput!): [Category!]!
  upsertCategory(input: CreateCategoryInput!): Category!
  deleteCategory(id: Int!): Boolean!
}

input CreateCategoryWithRelatedInput {
  category: CreateCategoryInput!
  products: CategoryProductsCreateNested
  users: CategoryUsersCreateNested
}

input UpdateCategoryWithRelatedInput {
  category: UpdateCategoryInput
  products: CategoryProductsUpdateNested
  users: CategoryUsersUpdateNested
}

input UpsertCategoryWithRelatedInput {
  category: CreateCategoryInput!
  products: CategoryProductsUpdateNested
  users: CategoryUsersUpdateNested
}

enum CategoryConflictTarget {
  NAME
  PK
}

input CategoryProductsCreateNested {
  create: [CategoryProductsCreateInput!]
}

input CategoryProductsUpdateNested {
  create: [CategoryProductsCreateInput!]
}

input CategoryProductsCreateInput {
  name: String!
  description: String
  price: Decimal!
  stock: Int!
  createdAt: Time!
  updatedAt: Time
  deletedAt: Time
}

input CategoryUsersCreateNested {
  create: [CreateUserInput!]
  connect: [UUID!]
}

input CategoryUsersUpdateNested {
  clear: Boolean
  create: [CreateUserInput!]
  connect: [UUID!]
  disconnect: [UUID!]
}

extend type Mutation {
  createCategoryWithRelated(input: CreateCategoryWithRelatedInput!): Category!
  updateCategoryWithRelated(id: Int!, input: UpdateCategoryWithRelatedInput!): Category!
  upsertCategoryWithRelated(input: UpsertCategoryWithRelatedInput!, conflictTarget: CategoryConflictTarget! = PK): Category!
}
