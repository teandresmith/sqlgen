"""
Product corresponds to the products table.
"""
type Product {
  "id"
  id: Int!
  "category_id"
  categoryID: Int!
  "title"
  title: String!
  "price"
  price: Float!
  "weight_kg"
  weightKg: Float
  "in_stock"
  inStock: Boolean!
  "sku"
  sku: String!
  "created_at"
  createdAt: DateTime!
  "one-to-many relationship with the order_items table."
  orderItems: [OrderItem!]!
  "one-to-many relationship with the product_tag_labels table."
  productTagLabels: [ProductTagLabel!]!
}

type ProductConnection {
  edges:      [ProductEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type ProductEdge {
  node:   Product!
  cursor: String!
}

type ProductListResult {
  items:      [Product!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input ProductFilter {
  categoryID: NumericComparator
  title: StringComparator
  price: NumericComparator
  weightKg: NullableNumericComparator
  inStock: BooleanComparator
  sku: StringComparator
  createdAt: TimeComparator
  orderItems: OrderItemFilter
  productTagLabels: ProductTagLabelFilter
  and: [ProductFilter!]
  or:  [ProductFilter!]
}

enum ProductSortField {
  ID
  CATEGORY_ID
  TITLE
  PRICE
  WEIGHT_KG
  IN_STOCK
  SKU
  CREATED_AT
}

input ProductSort {
  field:     ProductSortField!
  direction: SortDirection!
}
input CreateProductInput {
  categoryID: Int!
  title: String!
  price: Float!
  weightKg: Float
  inStock: Boolean!
  sku: String!
  createdAt: DateTime!
}
input UpdateProductInput {
  categoryID: Int
  title: String
  price: Float
  price_inc: Int
  price_dec: Int
  weightKg: Float
  weightKg_inc: Int
  weightKg_dec: Int
  inStock: Boolean
  sku: String
  createdAt: DateTime
}

extend type Query {
  product(id: Int!): Product
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to productList instead."
  products(filter: ProductFilter, first: Int, after: String, last: Int, before: String): ProductConnection!
  productList(filter: ProductFilter, sort: [ProductSort!], limit: Int, offset: Int): ProductListResult!
}

extend type Mutation {
  createProduct(input: CreateProductInput!): Product!
  createProducts(inputs: [CreateProductInput!]!): [Product!]!
  updateProduct(id: Int!, input: UpdateProductInput!): Product!
  updateProducts(filter: ProductFilter!, input: UpdateProductInput!): [Product!]!
  upsertProduct(input: CreateProductInput!): Product!
  deleteProduct(id: Int!): Boolean!
}
