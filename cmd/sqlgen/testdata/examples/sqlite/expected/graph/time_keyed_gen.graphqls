"""
TimeKeyed corresponds to the time_keyed table.
"""
type TimeKeyed {
  "at"
  at: DateTime!
  "label"
  label: String!
  "one-to-many relationship with the time_keyed_notes table."
  timeKeyedNotes: [TimeKeyedNote!]!
}

type TimeKeyedConnection {
  edges:      [TimeKeyedEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type TimeKeyedEdge {
  node:   TimeKeyed!
  cursor: String!
}

type TimeKeyedListResult {
  items:      [TimeKeyed!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input TimeKeyedFilter {
  label: StringComparator
  timeKeyedNotes: TimeKeyedNoteFilter
  and: [TimeKeyedFilter!]
  or:  [TimeKeyedFilter!]
}

enum TimeKeyedSortField {
  AT
  LABEL
}

input TimeKeyedSort {
  field:     TimeKeyedSortField!
  direction: SortDirection!
}
input CreateTimeKeyedInput {
  at: DateTime!
  label: String!
}
input UpdateTimeKeyedInput {
  label: String
}

extend type Query {
  timeKeyed(at: DateTime!): TimeKeyed
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to timeKeyedList instead."
  timeKeyeds(filter: TimeKeyedFilter, first: Int, after: String, last: Int, before: String): TimeKeyedConnection!
  timeKeyedList(filter: TimeKeyedFilter, sort: [TimeKeyedSort!], limit: Int, offset: Int): TimeKeyedListResult!
}

extend type Mutation {
  createTimeKeyed(input: CreateTimeKeyedInput!): TimeKeyed!
  createTimeKeyeds(inputs: [CreateTimeKeyedInput!]!): [TimeKeyed!]!
  updateTimeKeyed(at: DateTime!, input: UpdateTimeKeyedInput!): TimeKeyed!
  updateTimeKeyeds(filter: TimeKeyedFilter!, input: UpdateTimeKeyedInput!): [TimeKeyed!]!
  upsertTimeKeyed(input: CreateTimeKeyedInput!): TimeKeyed!
  deleteTimeKeyed(at: DateTime!): Boolean!
}
