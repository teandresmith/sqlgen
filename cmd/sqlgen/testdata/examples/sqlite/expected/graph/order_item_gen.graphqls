"""
OrderItem corresponds to the order_items table.
"""
type OrderItem {
  "id"
  id: Int!
  "order_id"
  orderID: Int!
  "product_id"
  productID: Int!
  "quantity"
  quantity: Int!
  "unit_price"
  unitPrice: Float!
}

type OrderItemConnection {
  edges:      [OrderItemEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type OrderItemEdge {
  node:   OrderItem!
  cursor: String!
}

type OrderItemListResult {
  items:      [OrderItem!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input OrderItemFilter {
  orderID: NumericComparator
  productID: NumericComparator
  quantity: NumericComparator
  unitPrice: NumericComparator
  and: [OrderItemFilter!]
  or:  [OrderItemFilter!]
}

enum OrderItemSortField {
  ID
  ORDER_ID
  PRODUCT_ID
  QUANTITY
  UNIT_PRICE
}

input OrderItemSort {
  field:     OrderItemSortField!
  direction: SortDirection!
}
input CreateOrderItemInput {
  orderID: Int!
  productID: Int!
  quantity: Int!
  unitPrice: Float!
}
input UpdateOrderItemInput {
  orderID: Int
  productID: Int
  quantity: Int
  quantity_inc: Int
  quantity_dec: Int
  unitPrice: Float
  unitPrice_inc: Int
  unitPrice_dec: Int
}

extend type Query {
  orderItem(id: Int!): OrderItem
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to orderItemList instead."
  orderItems(filter: OrderItemFilter, first: Int, after: String, last: Int, before: String): OrderItemConnection!
  orderItemList(filter: OrderItemFilter, sort: [OrderItemSort!], limit: Int, offset: Int): OrderItemListResult!
}

extend type Mutation {
  createOrderItem(input: CreateOrderItemInput!): OrderItem!
  createOrderItems(inputs: [CreateOrderItemInput!]!): [OrderItem!]!
  updateOrderItem(id: Int!, input: UpdateOrderItemInput!): OrderItem!
  updateOrderItems(filter: OrderItemFilter!, input: UpdateOrderItemInput!): [OrderItem!]!
  upsertOrderItem(input: CreateOrderItemInput!): OrderItem!
  deleteOrderItem(id: Int!): Boolean!
}
