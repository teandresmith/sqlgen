"""
TimeKeyedNote corresponds to the time_keyed_notes table.
"""
type TimeKeyedNote {
  "id"
  id: Int!
  "keyed_at"
  keyedAt: Time
  "note"
  note: String!
  "one-to-one relationship with the time_keyed table."
  timeKeyed: TimeKeyed
}

type TimeKeyedNoteConnection {
  edges:      [TimeKeyedNoteEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type TimeKeyedNoteEdge {
  node:   TimeKeyedNote!
  cursor: String!
}

type TimeKeyedNoteListResult {
  items:      [TimeKeyedNote!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input TimeKeyedNoteFilter {
  id: NumericComparator
  keyedAt: NullableTimeComparator
  note: StringComparator
  and: [TimeKeyedNoteFilter!]
  or:  [TimeKeyedNoteFilter!]
}

enum TimeKeyedNoteSortField {
  ID
  KEYED_AT
  NOTE
}

input TimeKeyedNoteSort {
  field:     TimeKeyedNoteSortField!
  direction: SortDirection!
}
input CreateTimeKeyedNoteInput {
  keyedAt: Time
  note: String!
}
input UpdateTimeKeyedNoteInput {
  keyedAt: Time
  note: String
}

extend type Query {
  timeKeyedNote(id: Int!): TimeKeyedNote
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to timeKeyedNoteList instead."
  timeKeyedNotes(filter: TimeKeyedNoteFilter, first: Int, after: String, last: Int, before: String): TimeKeyedNoteConnection!
  timeKeyedNoteList(filter: TimeKeyedNoteFilter, sort: [TimeKeyedNoteSort!], limit: Int, offset: Int): TimeKeyedNoteListResult!
}

extend type Mutation {
  createTimeKeyedNote(input: CreateTimeKeyedNoteInput!): TimeKeyedNote!
  createTimeKeyedNotes(inputs: [CreateTimeKeyedNoteInput!]!): [TimeKeyedNote!]!
  updateTimeKeyedNote(id: Int!, input: UpdateTimeKeyedNoteInput!): TimeKeyedNote!
  updateTimeKeyedNotes(filter: TimeKeyedNoteFilter!, input: UpdateTimeKeyedNoteInput!): [TimeKeyedNote!]!
  upsertTimeKeyedNote(input: CreateTimeKeyedNoteInput!): TimeKeyedNote!
  deleteTimeKeyedNote(id: Int!): Boolean!
}
