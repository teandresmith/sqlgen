"""
Catalog of products available for sale
"""
type Product {
  "Unique identifier"
  id: Int!
  "Parent category reference"
  categoryID: Int!
  "Product display name"
  title: String!
  "Unit price in default currency"
  price: Float!
  "Product weight in kilograms"
  weightKg: Float
  "Whether the product is currently available"
  inStock: Boolean!
  "Stock keeping unit code"
  sku: String!
  "Structured product attributes"
  attributes: JSON!
  "Row creation timestamp"
  createdAt: Time!
  "one-to-many relationship with the order_items table."
  orderItems: [OrderItem!]!
  "one-to-many relationship with the product_tag_labels table."
  productTagLabels: [ProductTagLabel!]!
}

type ProductConnection {
  edges:      [ProductEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type ProductEdge {
  node:   Product!
  cursor: String!
}

type ProductListResult {
  items:      [Product!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input ProductFilter {
  categoryID: NumericComparator
  title: StringComparator
  price: NumericComparator
  weightKg: NullableNumericComparator
  inStock: BooleanComparator
  sku: StringComparator
  attributes: JSONComparator
  createdAt: TimeComparator
  orderItems: OrderItemFilter
  productTagLabels: ProductTagLabelFilter
  and: [ProductFilter!]
  or:  [ProductFilter!]
}

enum ProductSortField {
  ID
  CATEGORY_ID
  TITLE
  PRICE
  WEIGHT_KG
  IN_STOCK
  SKU
  ATTRIBUTES
  CREATED_AT
}

input ProductSort {
  field:     ProductSortField!
  direction: SortDirection!
}
input CreateProductInput {
  categoryID: Int!
  title: String!
  price: Float!
  weightKg: Float
  inStock: Boolean!
  sku: String!
  attributes: JSON!
  createdAt: Time!
}
input UpdateProductInput {
  categoryID: Int
  title: String
  price: Float
  price_inc: Int
  price_dec: Int
  weightKg: Float
  weightKg_inc: Int
  weightKg_dec: Int
  inStock: Boolean
  sku: String
  attributes: JSON
  createdAt: Time
}

extend type Query {
  product(id: Int!): Product
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to productList instead."
  products(filter: ProductFilter, first: Int, after: String, last: Int, before: String): ProductConnection!
  productList(filter: ProductFilter, sort: [ProductSort!], limit: Int, offset: Int): ProductListResult!
}

extend type Mutation {
  createProduct(input: CreateProductInput!): Product!
  createProducts(inputs: [CreateProductInput!]!): [Product!]!
  updateProduct(id: Int!, input: UpdateProductInput!): Product!
  updateProducts(filter: ProductFilter!, input: UpdateProductInput!): [Product!]!
  upsertProduct(input: CreateProductInput!): Product!
  deleteProduct(id: Int!): Boolean!
}

input CreateProductWithRelatedInput {
  product: CreateProductInput!
  orderItems: ProductOrderItemsCreateNested
}

input UpdateProductWithRelatedInput {
  product: UpdateProductInput
  orderItems: ProductOrderItemsUpdateNested
}

input UpsertProductWithRelatedInput {
  product: CreateProductInput!
  orderItems: ProductOrderItemsUpdateNested
}

enum ProductConflictTarget {
  PK
  SKU
}

input ProductOrderItemsCreateNested {
  create: [ProductOrderItemsCreateInput!]
}

input ProductOrderItemsUpdateNested {
  create: [ProductOrderItemsCreateInput!]
}

input ProductOrderItemsCreateInput {
  orderID: Int!
  quantity: Int!
  unitPrice: Float!
}

extend type Mutation {
  createProductWithRelated(input: CreateProductWithRelatedInput!): Product!
  updateProductWithRelated(id: Int!, input: UpdateProductWithRelatedInput!): Product!
  upsertProductWithRelated(input: UpsertProductWithRelatedInput!, conflictTarget: ProductConflictTarget! = PK): Product!
}
