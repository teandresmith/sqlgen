	err := m.Client.WithTx(ctx, "update_{{ $t.SnakeName }}_where_inc", func(ctx context.Context) error {
		// An input with no set field writes nothing here and still returns the
		// matched rows, after the same empty-filter guard every bulk write
		// applies. Every column is read, so each row carries its key.
		matched, err := m.Client.{{ $t.ClientAccessor }}().UpdateWhere(ctx, filter, input.Set, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
			for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
				f(o)
			}
		})
		if err != nil {
			return err
		}
		res = []*{{ $pkg }}.{{ $t.StructName }}{}
		if len(matched) == 0 {
			return nil
		}
		keys := make([]{{ if $t.RowKeys.Composite }}{{ $pkg }}.{{ end }}{{ $t.RowKeys.ElemType }}, 0, len(matched))
		for _, row := range matched {
			for _, op := range incOps {
				if err := m.Client.{{ $t.ClientAccessor }}().Increment(ctx, {{ pkFromRow $pkg $t.StructName "row" $t.PKArgs }}, {{ $pkg }}.IncrementInput[{{ $pkg }}.{{ $t.IncrementEnumType }}]{
					Column: op.Column,
					Amount: op.Amount,
				}, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
					for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
						f(o)
					}
				}); err != nil {
