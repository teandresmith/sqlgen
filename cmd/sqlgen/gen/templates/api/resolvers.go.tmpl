{{- $ctx := . -}}
{{- $pkg := $ctx.ModelsPackage -}}

// Per-table query and mutation methods on *Q and *M. The
// receivers are sqlgen-owned types living in a sub-package so gqlgen's
// resolvergen plugin never scans, copies, or attempts to stub them. Seed
// files in the parent graph package delegate from the gqlgen-emitted
// *queryResolver / *mutationResolver methods into r.Q.X(...) / r.M.Y(...).
//
// Q/M methods take model-side types only — that breaks the cycle that would
// otherwise form between this sub-package and graph (graph's gqlgen-generated
// input types depend on graph's package; seed-side translation maps them
// onto these methods' model-shape parameters).

// Q is the query helper struct for sqlgen-managed Query.* fields.
type Q struct {
	Client *{{ $pkg }}.{{ $ctx.ClientName }}
}

// M is the mutation helper struct for sqlgen-managed Mutation.* fields.
type M struct {
	Client *{{ $pkg }}.{{ $ctx.ClientName }}
}

// IncrementOp is the per-column increment dispatch shape used by Update*
// methods. Amount may be negative to express decrement.
type IncrementOp[T comparable] struct {
	Column T
	Amount int
}

// InvalidInputError builds a gqlerror.Error tagged with INVALID_INPUT for
// runtime conflict checks on input operators. Exported so
// seed files in the parent graph package can call it directly.
func InvalidInputError(msg string) error {
	return &gqlerror.Error{
		Message:    msg,
		Extensions: map[string]any{"code": "INVALID_INPUT"},
	}
}

