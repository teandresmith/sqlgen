// Update{{ $t.StructName }}Request is one update{{ $t.StructName }} /
// update{{ $t.StructNamePlural }} input on its way from the graph package:
// the column values as the model's update input, and
{{- if $t.UpdateOps }} each `_inc` / `_dec`
// operator amount as the client sent it (nil when absent). The methods below
// own every rule about how the two combine.
{{- else }} nothing else — this
// table has no incrementable column, so the input carries no `_inc` / `_dec`
// operator.
{{- end }}
type Update{{ $t.StructName }}Request struct {
	// Set holds the column values to assign. Never nil.
	Set *{{ $pkg }}.Update{{ $t.StructName }}Input
	// HasSet reports whether Set holds at least one present field.
	HasSet bool
{{- range $op := $t.UpdateOps }}
	{{ $op.IncGoField }} *int
	{{ $op.DecGoField }} *int
{{- end }}
}
{{- end }}

{{- if and $t.Operations.Update $t.HasUpdateInput }}
// Update{{ $t.StructName }} resolves the single-row update mutation for {{ $t.SQLTable }}.
{{- if $t.UpdateOps }}
// The input carries paired `<col>_inc` / `<col>_dec` operators for every
// numeric column. Illegal pairings are rejected with INVALID_INPUT before
// anything is written; the method then applies `_set`, then each column's
// `_inc` / `_dec` as a signed Increment, and re-fetches the entity so the
// mutation result reflects the post-dispatch state.
{{- else }}
// This table has no numeric non-PK columns, so no `_inc`/`_dec` dispatch is
// generated. The method applies the set input (when non-empty) and
// re-fetches the entity.
{{- end }}
func (m *M) Update{{ $t.StructName }}(ctx context.Context, {{ pkGoArgs $t.PKArgs }}, input Update{{ $t.StructName }}Request) (*{{ $pkg }}.{{ $t.StructName }}, error) {
{{- if $t.UpdateOps }}
{{- range $op := $t.UpdateOps }}
	if input.Set.{{ $op.SetGoField }}.IsSet() && input.{{ $op.IncGoField }} != nil {
		return nil, InvalidInputError("update {{ $t.SQLTable }}: column \"{{ $op.SQLName }}\" cannot be both set and incremented in one mutation")
	}
	if input.Set.{{ $op.SetGoField }}.IsSet() && input.{{ $op.DecGoField }} != nil {
		return nil, InvalidInputError("update {{ $t.SQLTable }}: column \"{{ $op.SQLName }}\" cannot be both set and decremented in one mutation")
	}
	if input.{{ $op.IncGoField }} != nil && input.{{ $op.DecGoField }} != nil {
		return nil, InvalidInputError("update {{ $t.SQLTable }}: column \"{{ $op.SQLName }}\" cannot be both incremented and decremented in one mutation")
	}
{{- end }}
	var incOps []IncrementOp[{{ $pkg }}.{{ $t.IncrementEnumType }}]
{{- range $op := $t.UpdateOps }}
	if input.{{ $op.IncGoField }} != nil {
		incOps = append(incOps, IncrementOp[{{ $pkg }}.{{ $t.IncrementEnumType }}]{
			Column: {{ $pkg }}.{{ $op.IncColumnConst }},
			Amount: *input.{{ $op.IncGoField }},
		})
	}
	if input.{{ $op.DecGoField }} != nil {
		incOps = append(incOps, IncrementOp[{{ $pkg }}.{{ $t.IncrementEnumType }}]{
			Column: {{ $pkg }}.{{ $op.IncColumnConst }},
			Amount: -*input.{{ $op.DecGoField }},
		})
	}
{{- end }}
{{- end }}
	fo := {{ toCamelCase $t.StructName }}FieldOptionsFromContext(ctx)
	if input.HasSet {
		if _, err := m.Client.{{ $t.ClientAccessor }}().Update(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, input.Set, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
			for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
				f(o)
			}
		}); err != nil {
			return nil, mapErrorToGQL(err)
		}
	}
{{- if $t.UpdateOps }}
	for _, op := range incOps {
		if err := m.Client.{{ $t.ClientAccessor }}().Increment(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, {{ $pkg }}.IncrementInput[{{ $pkg }}.{{ $t.IncrementEnumType }}]{
			Column: op.Column,
			Amount: op.Amount,
		}, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
			for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
				f(o)
			}
		}); err != nil {
			return nil, mapErrorToGQL(err)
		}
	}
{{- end }}
	res, err := m.Client.{{ $t.ClientAccessor }}().Get(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
		o.FieldOptions = fo
		for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
			f(o)
		}
	})
	if err != nil {
		return nil, mapErrorToGQL(err)
	}
	return res, nil
}
{{- end }}

