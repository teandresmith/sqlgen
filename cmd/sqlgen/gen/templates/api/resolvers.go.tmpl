// Update{{ $t.StructName }}WithRelated resolves the nested update mutation for
// {{ $t.SQLTable }}.
//
// The flat half is Update{{ $t.StructName }}Input, so it carries the `_inc` /
// `_dec` operators update{{ $t.StructName }} does, and the Go
// method has no place for them. When any is set, the method, the increments
// and the read-back run in one transaction — UpdateWithRelated as a savepoint
// inside it — so the mutation stays the single atomic write a nested mutation promises
// rather than committing its nested rows before an increment can fail.
func (m *M) Update{{ $t.StructName }}WithRelated(ctx context.Context, {{ pkGoArgs $t.PKArgs }}, input *{{ $pkg }}.{{ $n.UpdateInputName }}, incOps []IncrementOp[{{ $pkg }}.{{ $t.IncrementEnumType }}]) (*{{ $pkg }}.{{ $t.StructName }}, error) {
	fo := {{ toCamelCase $t.StructName }}FieldOptionsFromContext(ctx)
	if len(incOps) == 0 {
		res, err := m.Client.{{ $t.ClientAccessor }}().UpdateWithRelated(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, input, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
			o.FieldOptions = fo
			for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
				f(o)
			}
		})
		if err != nil {
			return nil, mapErrorToGQL(err)
		}
		return res, nil
	}
	var res *{{ $pkg }}.{{ $t.StructName }}
	err := m.Client.WithTx(ctx, "{{ $n.IncrementTxName }}", func(ctx context.Context) error {
		if _, err := m.Client.{{ $t.ClientAccessor }}().UpdateWithRelated(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, input, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
			for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
				f(o)
			}
		}); err != nil {
			return err
		}
		for _, op := range incOps {
			if err := m.Client.{{ $t.ClientAccessor }}().Increment(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, {{ $pkg }}.IncrementInput[{{ $pkg }}.{{ $t.IncrementEnumType }}]{
				Column: op.Column,
				Amount: op.Amount,
			}, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
				for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
					f(o)
				}
			}); err != nil {
				return err
			}
		}
		// The read-back is the Go method's terminal re-read, moved here because
		// the increments must precede it, so it runs as that read does: with
		// hooks — and so the cache — skipped. The writes above
		// defer their cache invalidation to commit, and a read-through here
		// would answer the mutation with the row's pre-mutation state.
		var err error
		res, err = m.Client.{{ $t.ClientAccessor }}().Get(ctx, {{ pkConvert $pkg $t.StructName $t.PKArgs }}, func(o *{{ $pkg }}.CallOptions[{{ $pkg }}.{{ $t.StructName }}FieldOptions]) {
			o.FieldOptions = fo
			for _, f := range callOptionsFromHTTP[{{ $pkg }}.{{ $t.StructName }}FieldOptions](ctx) {
				f(o)
			}
			o.SkipHooks = true
		})
		return err
	})
	if err != nil {
		return nil, mapErrorToGQL(err)
	}
	return res, nil
}
{{- else }}
