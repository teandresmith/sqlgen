{{- range $w := .NumericWidthScalars }}
{{- if eq $w.Name "Float32" }}

// MarshalFloat32 marshals a float32 as a GraphQL Float.
//
// gqlgen binds the Float scalar to float64 alone (graphql/float.go), so a
// `real` / `float4` / MySQL `float` column has no binding at all and gqlgen
// answers the field with a panic("not implemented") resolver. This pair is
// that binding; the wrapper appends it to the Float `models:` list, where it
// sits behind gqlgen's own entry so every generated input field keeps its
// float64 type and its float32 width cast.
//
// Formatted at bitSize 32 so the wire carries the value the column actually
// holds — %g against a float64-widened float32 prints the widening artefact
// (0.1 as 0.10000000149011612).
func MarshalFloat32(v float32) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		_, _ = io.WriteString(w, strconv.FormatFloat(float64(v), 'g', -1, 32))
	})
}

// UnmarshalFloat32 parses a float32 from a GraphQL Float input value.
//
// Narrowing is unchecked on purpose: a float64 outside float32's range becomes
// ±Inf and one below its precision loses digits, but both are lossy
// REPRESENTATION rather than a domain error, and the column itself is what
// declared the narrower width. Rejecting them would make ordinary values
// unwritable through the API that are writable through the Go client.
func UnmarshalFloat32(v any) (float32, error) {
	f, err := graphql.UnmarshalFloat(v)
	if err != nil {
		return 0, err
	}
	return float32(f), nil
}
{{- end }}
{{- end }}
