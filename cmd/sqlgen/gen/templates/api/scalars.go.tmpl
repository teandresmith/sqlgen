// MarshalNullFloat64 marshals a sql.NullFloat64, emitting `null` when Valid is
// false and otherwise delegating to gqlgen's Float marshaler — its partner.
//
// Delegation carries the partner's behaviour for non-finite values: gqlgen
// formats with %g, so a NaN or ±Inf column value emits a bare NaN / +Inf token
// that is not valid JSON. That is a property of the `Float` scalar itself
// rather than of this wrapper, and diverging here would break the invariant
// that a pair shares one wire format.
func MarshalNullFloat64(v sql.NullFloat64) graphql.Marshaler {
	if !v.Valid {
		return graphql.Null
	}
	return graphql.MarshalFloat(v.Float64)
}

// UnmarshalNullFloat64 collapses nil to sql.NullFloat64{Valid: false}.
func UnmarshalNullFloat64(v any) (sql.NullFloat64, error) {
	if v == nil {
		return sql.NullFloat64{}, nil
	}
	f, err := graphql.UnmarshalFloat(v)
	if err != nil {
		return sql.NullFloat64{}, err
	}
	return sql.NullFloat64{Float64: f, Valid: true}, nil
}
{{- end }}
{{- if eq $s.Name "NullTime" }}

// MarshalNullTime marshals a sql.NullTime, emitting `null` when Valid is false
// and otherwise delegating to gqlgen's Time marshaler — its partner, the
// gqlgen-bundled `Time` scalar — so both carry RFC 3339 identically.
//
// gqlgen's marshaler also emits null for a zero time. A Valid zero timestamp
// is degenerate, and matching the partner exactly is the invariant.
func MarshalNullTime(v sql.NullTime) graphql.Marshaler {
	if !v.Valid {
		return graphql.Null
	}
	return graphql.MarshalTime(v.Time)
}

// UnmarshalNullTime collapses nil to sql.NullTime{Valid: false}.
func UnmarshalNullTime(v any) (sql.NullTime, error) {
	if v == nil {
		return sql.NullTime{}, nil
	}
	t, err := graphql.UnmarshalTime(v)
	if err != nil {
		return sql.NullTime{}, err
	}
	return sql.NullTime{Time: t, Valid: true}, nil
}
{{- end }}
