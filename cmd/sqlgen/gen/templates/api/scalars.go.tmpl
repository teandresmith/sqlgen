{{- define "api/scalars" -}}
{{- range $s := .ExternalScalars }}
{{- if eq $s.Name "UUID" }}

// MarshalUUID marshals a uuid.UUID into a JSON-quoted string for GraphQL.
//
// Unlike gqlgen's bundled MarshalUUID (which silently emits `null` when the
// value equals uuid.Nil), this marshaler writes the underlying string
// unconditionally — a non-null field holding the Go zero value is a model-
// layer bug, and silently emitting null would mask it. Consumers that need
// null semantics should use the paired NullUUID scalar.
func MarshalUUID(v uuid.UUID) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		_, _ = io.WriteString(w, strconv.Quote(v.String()))
	})
}

// UnmarshalUUID parses a uuid.UUID from a GraphQL input value.
func UnmarshalUUID(v any) (uuid.UUID, error) {
	s, ok := v.(string)
	if !ok {
		return uuid.UUID{}, fmt.Errorf("UUID must be a string, got %T", v)
	}
	return {{ $.ParseUUIDFunc }}(s)
}
{{- end }}
{{- if eq $s.Name "NullUUID" }}

// MarshalNullUUID marshals a uuid.NullUUID. When Valid is false it emits the
// GraphQL `null` literal; otherwise it writes the underlying UUID as a
// JSON-quoted string. Paired with the UUID scalar — both share the same
// wire format (string or null), the wrapper's Valid field is a Go-side
// detail.
func MarshalNullUUID(v uuid.NullUUID) graphql.Marshaler {
	if !v.Valid {
		return graphql.Null
	}
	return graphql.WriterFunc(func(w io.Writer) {
		_, _ = io.WriteString(w, strconv.Quote(v.UUID.String()))
	})
}

// UnmarshalNullUUID parses a uuid.NullUUID from a GraphQL input value. A nil
// input collapses to uuid.NullUUID{Valid:false}; a string input parses into
// the wrapper with Valid:true.
func UnmarshalNullUUID(v any) (uuid.NullUUID, error) {
	if v == nil {
		return uuid.NullUUID{}, nil
	}
	s, ok := v.(string)
	if !ok {
		return uuid.NullUUID{}, fmt.Errorf("NullUUID must be a string or null, got %T", v)
	}
	parsed, err := {{ $.ParseUUIDFunc }}(s)
	if err != nil {
		return uuid.NullUUID{}, err
	}
	return uuid.NullUUID{UUID: parsed, Valid: true}, nil
}
{{- end }}
