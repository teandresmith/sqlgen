{{- if eq $s.Name "NullInt16" }}

// MarshalNullInt16 marshals a sql.NullInt16, emitting `null` when Valid is
// false and otherwise delegating to gqlgen's Int16 marshaler.
func MarshalNullInt16(v sql.NullInt16) graphql.Marshaler {
	if !v.Valid {
		return graphql.Null
	}
	return graphql.MarshalInt16(v.Int16)
}

// UnmarshalNullInt16 collapses nil to sql.NullInt16{Valid: false}.
//
// graphql.UnmarshalInt16 accepts every shape the request decoder can produce
// for an integer (int/int8/…/int64, string, json.Number) and range-checks the
// result against int16, returning gqlgen's own overflow error. A hand-written
// `v.(int)` assertion here would reject an inline literal — gqlparser parses
// IntValue with strconv.ParseInt(…, 64), so it arrives as int64 — and every
// HTTP variable, which arrives as json.Number.
func UnmarshalNullInt16(v any) (sql.NullInt16, error) {
	if v == nil {
		return sql.NullInt16{}, nil
	}
	n, err := graphql.UnmarshalInt16(v)
	if err != nil {
		return sql.NullInt16{}, err
	}
	return sql.NullInt16{Int16: n, Valid: true}, nil
}
{{- end }}
