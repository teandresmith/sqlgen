{{- if eq $s.Name "JSON" }}

// MarshalJSON marshals a json.RawMessage into the GraphQL output stream verbatim.
func MarshalJSON(v json.RawMessage) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		if len(v) == 0 {
			_, _ = io.WriteString(w, "null")
			return
		}
		_, _ = w.Write(v)
	})
}

// UnmarshalJSON parses a json.RawMessage from a GraphQL input value.
func UnmarshalJSON(v any) (json.RawMessage, error) {
	switch x := v.(type) {
	case string:
		return json.RawMessage(x), nil
	case []byte:
		return json.RawMessage(x), nil
	case json.RawMessage:
		return x, nil
	default:
		b, err := json.Marshal(x)
		if err != nil {
			return nil, fmt.Errorf("JSON marshal: %w", err)
		}
		return b, nil
	}
}
{{- end }}
{{- if eq $s.Name "Bytes" }}

// MarshalBytes marshals a []byte as a base64 (standard encoding) JSON string,
// the wire form fixed for the Bytes scalar.
//
// Binary columns (`bytea`, `blob`, `binary`, `varbinary`, …) previously bound
// to the GraphQL `String` scalar, which pretended the bytes were UTF-8 text
// and emitted a translator that did not compile. base64 round-trips
// every byte sequence exactly; a nil slice marshals as an empty string rather
// than null, because null is the nullable field's own encoding.
func MarshalBytes(v []byte) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		_, _ = io.WriteString(w, strconv.Quote(base64.StdEncoding.EncodeToString(v)))
	})
}

// UnmarshalBytes decodes a base64 string into a []byte.
func UnmarshalBytes(v any) ([]byte, error) {
	s, ok := v.(string)
	if !ok {
		return nil, fmt.Errorf("Bytes must be a base64 string, got %T", v)
	}
	return base64.StdEncoding.DecodeString(s)
}
{{- end }}
{{- if eq $s.Name "Duration" }}

// MarshalDuration marshals a time.Duration as a Go duration string ("1h30m0s"),
// the wire form fixed for the Duration scalar. Chosen over ISO-8601
// because time.ParseDuration reads it back exactly, with no hand-written
// parser between the wire and the value.
func MarshalDuration(v time.Duration) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		_, _ = io.WriteString(w, strconv.Quote(v.String()))
	})
}

// UnmarshalDuration parses a Go duration string into a time.Duration.
func UnmarshalDuration(v any) (time.Duration, error) {
	s, ok := v.(string)
	if !ok {
		return 0, fmt.Errorf("Duration must be a string, got %T", v)
	}
	return time.ParseDuration(s)
}
{{- end }}
{{- if eq $s.Name "IP" }}

// MarshalIP marshals a net.IP as its textual form ("10.0.0.1", "2001:db8::1").
//
// A nil IP writes an empty string rather than net.IP(nil).String()'s "<nil>",
// which is not a parseable address — the same hazard MarshalUUID documents for
// uuid.Nil. A NOT NULL column holding the zero value is a model-layer bug, and
// emitting a value that fails to round-trip would hide it downstream.
func MarshalIP(v net.IP) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		if len(v) == 0 {
			_, _ = io.WriteString(w, `""`)
			return
		}
		_, _ = io.WriteString(w, strconv.Quote(v.String()))
	})
}

// UnmarshalIP parses a textual IP address into a net.IP, normalizing IPv4 to
// its 4-byte form.
//
// net.ParseIP returns the 16-byte IPv4-in-IPv6 representation for a dotted
// quad, and a driver encodes that into a PostgreSQL `inet` as
// "::ffff:10.0.0.1/128" rather than "10.0.0.1/32". Both render as "10.0.0.1"
// through net.IP.String(), so the GraphQL round-trip hides the difference
// entirely — but the stored value is a different inet, matching neither a text
// comparison nor the subnet operators (<<, <<=, >>, >>=), and it is what any
// non-sqlgen reader of the column sees.
//
// Normalizing here rather than at each call site covers the filter path as
// well as the write path: gqlgen routes every IP operand through this
// function, list elements included, so an IPComparator operand arrives at the
// model layer already normalized. Values read back out of the database need no
// normalization — the driver decodes `inet` into the 4-byte form already.
func UnmarshalIP(v any) (net.IP, error) {
	s, ok := v.(string)
	if !ok {
		return nil, fmt.Errorf("IP must be a string, got %T", v)
	}
	ip := net.ParseIP(s)
	if ip == nil {
		return nil, fmt.Errorf("IP: %q is not a valid IP address", s)
	}
	// To4 reports nil for a genuine IPv6 address, so the guard is required —
	// without it every IPv6 value would collapse to nil.
	if v4 := ip.To4(); v4 != nil {
		return v4, nil
	}
	return ip, nil
}
{{- end }}
{{- if eq $s.Name "CIDR" }}

// MarshalCIDR marshals a net.IPNet in CIDR notation ("10.0.0.0/8").
func MarshalCIDR(v net.IPNet) graphql.Marshaler {
	return graphql.WriterFunc(func(w io.Writer) {
		if len(v.IP) == 0 {
			_, _ = io.WriteString(w, `""`)
			return
		}
		_, _ = io.WriteString(w, strconv.Quote(v.String()))
	})
}

// UnmarshalCIDR parses CIDR notation into a net.IPNet.
//
// net.ParseCIDR returns the masked network, which is what a PostgreSQL `cidr`
// column stores — "10.0.0.1/8" is accepted and normalised to "10.0.0.0/8",
// matching the database's own coercion.
func UnmarshalCIDR(v any) (net.IPNet, error) {
	s, ok := v.(string)
	if !ok {
		return net.IPNet{}, fmt.Errorf("CIDR must be a string, got %T", v)
	}
	_, network, err := net.ParseCIDR(s)
	if err != nil {
		return net.IPNet{}, err
	}
	return *network, nil
}
{{- end }}
