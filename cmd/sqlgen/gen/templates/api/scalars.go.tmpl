{{- if eq $s.Name "NullString" }}

// MarshalNullString marshals a sql.NullString, emitting the GraphQL `null`
// literal when Valid is false.
//
// The value half delegates to gqlgen's own String marshaler rather than
// re-implementing it. That is what makes the shared wire-format invariant
// structural: this scalar's partner IS the spec built-in `String`, so sharing
// its marshaler is the only way the two cannot drift. The `Valid` bool stays a
// Go-side detail and never reaches the wire.
func MarshalNullString(v sql.NullString) graphql.Marshaler {
	if !v.Valid {
		return graphql.Null
	}
	return graphql.MarshalString(v.String)
}

// UnmarshalNullString collapses nil to sql.NullString{Valid: false} and
// delegates the value half to gqlgen's String unmarshaler.
//
// Delegating is not a convenience. A scalar unmarshaler receives whatever the
// request decoder produced, which is NOT the Go type gqlgen binds the scalar
// to: an inline literal arrives as gqlparser parsed it, and an HTTP variable
// arrives as encoding/json decoded it (`json.Number`, since the handler calls
// UseNumber). Hand-rolling a type assertion here rejects valid requests.
func UnmarshalNullString(v any) (sql.NullString, error) {
	if v == nil {
		return sql.NullString{}, nil
	}
	s, err := graphql.UnmarshalString(v)
	if err != nil {
		return sql.NullString{}, err
	}
	return sql.NullString{String: s, Valid: true}, nil
}
{{- end }}
