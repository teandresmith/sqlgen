// {{ $enum.SliceGoTypeName }} represents a PostgreSQL array of {{ $enum.GoTypeName }} values.
// It implements driver.Valuer and sql.Scanner using the PostgreSQL array text format
// so that pgx can handle custom enum array OIDs without manual type registration.
type {{ $enum.SliceGoTypeName }} []{{ $enum.GoTypeName }}

// String returns the PostgreSQL array literal representation.
func (s {{ $enum.SliceGoTypeName }}) String() string {
	parts := make([]string, len(s))
	for i, v := range s {
		parts[i] = string(v)
	}
	return "{" + strings.Join(parts, ",") + "}"
}

// Value implements driver.Valuer.
func (s {{ $enum.SliceGoTypeName }}) Value() (driver.Value, error) {
	if s == nil {
		return nil, nil
	}
	return s.String(), nil
}

// Scan implements sql.Scanner.
func (s *{{ $enum.SliceGoTypeName }}) Scan(src any) error {
	if src == nil {
		*s = nil
		return nil
	}
	var str string
	switch v := src.(type) {
	case string:
		str = v
	case []byte:
		str = string(v)
	default:
		return fmt.Errorf("scanning %T into {{ $enum.SliceGoTypeName }}", src)
	}
	str = strings.TrimPrefix(str, "{")
	str = strings.TrimSuffix(str, "}")
	if str == "" {
		*s = {{ $enum.SliceGoTypeName }}{}
		return nil
	}
	parts := strings.Split(str, ",")
	result := make({{ $enum.SliceGoTypeName }}, len(parts))
	for i, p := range parts {
		result[i] = {{ $enum.GoTypeName }}(p)
	}
	*s = result
	return nil
}

// MarshalGQL writes the JSON array of GraphQL enum identifiers to w. Lets
// gqlgen bind the GraphQL list type (`[{{ $enum.GoTypeName }}!]!`) directly to
// this named slice via the `models:` mapping, avoiding the per-field resolver
// stub gqlgen would otherwise emit for a list-of-bound-scalar shape.
func (s {{ $enum.SliceGoTypeName }}) MarshalGQL(w io.Writer) {
	w.Write([]byte("["))
	for i, v := range s {
		if i > 0 {
			w.Write([]byte(","))
		}
		v.MarshalGQL(w)
	}
	w.Write([]byte("]"))
}

// UnmarshalGQL parses a JSON array of GraphQL enum identifiers (the wire form
// gqlgen produces for an inbound `[{{ $enum.GoTypeName }}!]` argument) into
// the named slice. Each element round-trips through the bare enum's
// UnmarshalGQL so unknown identifiers surface a typed validation error.
func (s *{{ $enum.SliceGoTypeName }}) UnmarshalGQL(v any) error {
	raw, ok := v.([]any)
	if !ok {
		return fmt.Errorf("expected []any for {{ $enum.SliceGoTypeName }}, got %T", v)
	}
	out := make({{ $enum.SliceGoTypeName }}, 0, len(raw))
	for i, item := range raw {
		var elem {{ $enum.GoTypeName }}
		if err := elem.UnmarshalGQL(item); err != nil {
			return fmt.Errorf("{{ $enum.SliceGoTypeName }}[%d]: %w", i, err)
		}
		out = append(out, elem)
	}
	*s = out
	return nil
}
