// MarshalGQL writes the GraphQL enum identifier (SCREAMING_SNAKE_CASE) for s
// onto w. Implements gqlgen's graphql.Marshaler interface via duck typing so
// the models package can be bound directly as a GraphQL enum through the
// `models:` mapping without importing gqlgen. The wire identifier
// (`ASSETPRIMARY`) is the SCREAMING-cased Go constant suffix; the underlying
// string value (e.g. `"asset.primary"`) stays in the Go variable and lands in
// the database column unchanged.
func (s {{ $enum.GoTypeName }}) MarshalGQL(w io.Writer) {
	var name string
	switch s {
{{- range $v := $enum.Values }}
	case {{ $enum.GoTypeName }}{{ $v | toPascalCase }}:
		name = {{ printf "%q" (gqlEnumIdent $v) }}
{{- end }}
	default:
		name = ""
	}
	fmt.Fprintf(w, "%q", name)
}

// UnmarshalGQL parses the GraphQL enum identifier received from a client into
// the typed value. Mirrors MarshalGQL on the inbound path. Returns an error on
// unknown identifier so gqlgen surfaces a typed validation failure rather than
// inserting a zero-value enum into the database.
func (s *{{ $enum.GoTypeName }}) UnmarshalGQL(v any) error {
	str, ok := v.(string)
	if !ok {
		return fmt.Errorf("expected string for {{ $enum.GoTypeName }}, got %T", v)
	}
	switch str {
{{- range $v := $enum.Values }}
	case {{ printf "%q" (gqlEnumIdent $v) }}:
		*s = {{ $enum.GoTypeName }}{{ $v | toPascalCase }}
{{- end }}
	default:
		return fmt.Errorf("invalid {{ $enum.GoTypeName }}: %q", str)
	}
	return nil
}

