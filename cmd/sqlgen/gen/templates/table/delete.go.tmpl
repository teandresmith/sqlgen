// any other takes the tenant the remaining rows share, or none when they
// carry more than one.
func (c *{{ $structCamel }}Client) recordWrittenTenants(tenantByPK map[{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}]any, listed []{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}, rowTenants map[{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}]any) {
	found := make(map[{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}]struct{}, len(rowTenants))
	for _, key := range listed {
		if tenant, ok := rowTenants[key]; ok {
			tenantByPK[key] = tenant
			found[key] = struct{}{}
		}
	}
	if len(found) == len(rowTenants) {
		return
	}

	// The tenant of the rows no listed key found under ==, when they share one.
	// Tenants compare by their %v form, the form tenant-scoped cache keys use.
	var shared any
	for key, tenant := range rowTenants {
		if _, ok := found[key]; ok {
			continue
		}
		if shared == nil {
			shared = tenant
			continue
		}
		if fmt.Sprint(shared) != fmt.Sprint(tenant) {
			shared = nil
			break
		}
	}
	for _, key := range listed {
		if _, ok := tenantByPK[key]; !ok {
			tenantByPK[key] = shared
		}
	}
}
{{- end }}
{{- end -}}

{{- /* The affected keys of a by-key batch write: the listed keys a sub-batch
       wrote, in the order they were listed. A tenant-capturing table knows a
       key was written when its tenant was captured; every other table keeps
       the written-key set. */ -}}
{{- define "table/delete-many-affected" }}
{{- $keys := "ids" }}{{ if .CompositePK }}{{ $keys = "pks" }}{{ end }}

		// A listed key whose row this call did not write records no affected
		// key, so no cache entry is invalidated and no event is published for it.
		affectedPKs := make([]any, 0, len({{ $keys }}))
{{- if and .Tenancy .Tenancy.Tenanted (not .Tenancy.InPrimaryKey) }}
		affectedTenants := make([]any, 0, len({{ $keys }}))
		for _, key := range {{ $keys }} {
			tenant, ok := tenantByPK[key]
			if !ok {
				continue
			}
			affectedPKs = append(affectedPKs, key)
			affectedTenants = append(affectedTenants, tenant)
		}
		m.AffectedPKs = affectedPKs
		m.AffectedTenants = affectedTenants
{{- else }}
		for _, key := range {{ $keys }} {
			if _, ok := written[{{ .KeySetKey "key" }}]; ok {
				affectedPKs = append(affectedPKs, key)
			}
		}
		m.AffectedPKs = affectedPKs
{{- end }}
