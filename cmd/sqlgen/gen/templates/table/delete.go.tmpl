// HardDelete permanently removes a {{ $singular }} from the database.
// Idempotent — returns nil if the primary key does not exist.
func (c *{{ $structCamel }}Client) HardDelete(ctx context.Context, {{ if .CompositePK }}pk {{ .CompositePKStructName }}{{ else }}id {{ $pkCol.GoType }}{{ end }}, opts ...func(*CallOptions[{{ .StructName }}FieldOptions])) error {
