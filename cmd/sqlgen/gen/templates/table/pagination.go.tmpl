{{- define "table/pagination" -}}
{{- $singular := .TableName | toSingular -}}
{{- $structCamel := .StructName | toCamelCase -}}
{{- $resultVar := .StructName | structNamePlural | toCamelCase }}
{{- if .Operations.Paginate }}

// Paginate returns a page of {{ .TableName }} with total count for offset-based pagination.
{{- if and .SoftDelete .ExcludeDeleted }}
// Soft-deleted {{ .TableName }} are excluded by default. Set Filter.{{ .SoftDelete.FieldName }} to override.
{{- end }}
// A nil filter paginates all {{ if and .SoftDelete .ExcludeDeleted }}non-deleted {{ end }}{{ .TableName }}.
func (c *{{ $structCamel }}Client) Paginate(ctx context.Context, input PaginateInput[{{ .StructName }}Filter], opts ...func(*CallOptions[{{ .StructName }}FieldOptions])) (*PaginateResult[{{ .StructName }}], error) {
	options := resolveCallOptions(opts)
	result, err := c.executeQuery(ctx, options.SkipHooks, &hook.QueryContext{
		Op: hook.OpPaginate, Table: {{ .TableNameConstant }}, Schema: {{ printf "%q" .Schema }},
		Input: input, CallOptions: options,
	}, func(ctx context.Context, q *hook.QueryContext) (any, error) {
		// Internal calls with SkipHooks to prevent nested hook invocation
		internalOpts := func(o *CallOptions[{{ .StructName }}FieldOptions]) {
			*o = options
			o.SkipHooks = true
		}

		// Total count (delegates to Count — both are always generated)
		totalCount, err := c.Count(ctx, input.Filter, internalOpts)
		if err != nil {
			return nil, fmt.Errorf("paginate {{ .TableName }} count: %w", err)
		}

		// Page data via GetMany (handles FieldOptions and relationships)
		{{ $resultVar }}, err := c.GetMany(ctx, &Get{{ .StructName | structNamePlural }}Input{
			Filter: input.Filter,
			Sorts:  input.Sort,
			Limit:  &input.Limit,
			Offset: &input.Offset,
		}, internalOpts)
		if err != nil {
			return nil, fmt.Errorf("paginate {{ .TableName }}: %w", err)
		}

		return &PaginateResult[{{ .StructName }}]{
			Items:      {{ $resultVar }},
			TotalCount: totalCount,
			Offset:     input.Offset,
			Limit:      input.Limit,
			HasMore:    int64(input.Offset+input.Limit) < totalCount,
		}, nil
	})
	if err != nil {
		return nil, err
	}
	return result.(*PaginateResult[{{ .StructName }}]), nil
}
{{- end }}
{{- if .Operations.Connection }}

// Connection returns a Relay-style cursor-paginated connection of {{ .TableName }}.
// Sort order is determined by cursor_keys — custom sorts are not supported.
// Use Paginate for custom sort orders.
{{- if and .SoftDelete .ExcludeDeleted }}
// Soft-deleted {{ .TableName }} are excluded by default.
{{- end }}
func (c *{{ $structCamel }}Client) Connection(ctx context.Context, input ConnectionInput[{{ .StructName }}Filter], opts ...func(*CallOptions[{{ .StructName }}FieldOptions])) (*Connection[{{ .StructName }}], error) {
	options := resolveCallOptions(opts)
{{ template "shared/lock-mode-guard" (lockGuardCtx . (printf "connection %s" .TableName)) }}
	result, err := c.executeQuery(ctx, options.SkipHooks, &hook.QueryContext{
		Op: hook.OpConnection, Table: {{ .TableNameConstant }}, Schema: {{ printf "%q" .Schema }},
		Input: input, CallOptions: options,
	}, func(ctx context.Context, q *hook.QueryContext) (any, error) {
		// Internal calls with SkipHooks to prevent nested hook invocation
		internalOpts := func(o *CallOptions[{{ .StructName }}FieldOptions]) {
			*o = options
			o.SkipHooks = true
		}

		// Validate: first and last are mutually exclusive
		if input.First != nil && input.Last != nil {
			return nil, ErrInvalidCursor
		}

		// Total count (separate COUNT query — no cursor conditions)
		totalCount, err := c.Count(ctx, input.Filter, internalOpts)
		if err != nil {
			return nil, fmt.Errorf("connection {{ .TableName }} count: %w", err)
		}

		// Decode cursors and build keyset conditions
		var keysetConds []sql.Condition
		if input.After != nil {
			cursor, err := decodeCursor(*input.After)
			if err != nil {
				return nil, ErrInvalidCursor
			}
			keysetConds = append(keysetConds, cursorKeyset(c.dialect, c.cursorKeys, cursor, ">"))
		}
		if input.Before != nil {
			cursor, err := decodeCursor(*input.Before)
			if err != nil {
				return nil, ErrInvalidCursor
			}
			keysetConds = append(keysetConds, cursorKeyset(c.dialect, c.cursorKeys, cursor, "<"))
		}

		// Direction and limit
		limit := c.pageSize
		ascending := true
		if input.First != nil {
			limit = *input.First
		} else if input.Last != nil {
			limit = *input.Last
			ascending = false
		}

		// Fetch limit+1 rows via GetMany (handles FieldOptions, O2O joins, relationships, soft delete)
		connLimit := limit + 1
		{{ $resultVar }}, err := c.GetMany(ctx, &Get{{ .StructName | structNamePlural }}Input{
			Filter:     input.Filter,
			Sorts:      cursorSorts(c.cursorKeys, ascending),
			Limit:      &connLimit,
			conditions: keysetConds,
			// Each edge's cursor is encoded from the row it wraps, so the cursor
			// keys have to survive a narrowed FieldOptions — otherwise the
			// encoder reads fields the SELECT never filled and every cursor
			// carries zero values.
			requiredColumns: c.cursorKeys,
		}, internalOpts)
		if err != nil {
			return nil, fmt.Errorf("connection {{ .TableName }}: %w", err)
		}

		// Trim extra row and determine page boundaries
		hasMore := len({{ $resultVar }}) > limit
		if hasMore {
			{{ $resultVar }} = {{ $resultVar }}[:limit]
		}

		// Backward pagination: reverse for ascending cursor order
		if !ascending {
			slices.Reverse({{ $resultVar }})
		}

		// Build edges with encoded cursors
		edges := make([]Edge[{{ .StructName }}], len({{ $resultVar }}))
		for i, row := range {{ $resultVar }} {
			cursor, err := encode{{ .StructName }}Cursor(c.cursorKeys, row)
			if err != nil {
				return nil, err
			}
			edges[i] = Edge[{{ .StructName }}]{
				Node:   row,
				Cursor: cursor,
			}
		}

		pageInfo := PageInfo{
			HasNextPage:     (ascending && hasMore) || (!ascending && input.Before != nil),
			HasPreviousPage: (!ascending && hasMore) || (ascending && input.After != nil),
		}
		if len(edges) > 0 {
			pageInfo.StartCursor = &edges[0].Cursor
			pageInfo.EndCursor = &edges[len(edges)-1].Cursor
		}

		return &Connection[{{ .StructName }}]{Edges: edges, PageInfo: pageInfo, TotalCount: totalCount}, nil
	})
	if err != nil {
		return nil, err
	}
	return result.(*Connection[{{ .StructName }}]), nil
}

// encode{{ .StructName }}Cursor encodes cursor key values as a base64 JSON string.
func encode{{ .StructName }}Cursor(keys []string, {{ .VarName }} *{{ .StructName }}) (string, error) {
	out := make(map[string]any, len(keys))
	for _, key := range keys {
		switch key {
{{- range .Columns }}
		case {{ printf "%q" .Name }}:
			out[{{ printf "%q" .Name }}] = {{ $.VarName }}.{{ .FieldName }}
{{- end }}
		}
	}
	data, err := json.Marshal(out)
	if err != nil {
		return "", fmt.Errorf("encode {{ $singular }} cursor: %w", err)
	}
	return base64.StdEncoding.EncodeToString(data), nil
}
{{- end }}
{{- end -}}
