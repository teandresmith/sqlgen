{{- define "table/update" -}}
{{- $pkCol := index .PKColumns 0 -}}
{{- $singular := .TableName | toSingular -}}
{{- $structCamel := .StructName | toCamelCase -}}
{{- $captureTenant := and .Tenancy .Tenancy.Tenanted (not .Tenancy.InPrimaryKey) }}
{{- if .Operations.Update }}

// Update partially updates a {{ $singular }} by primary key and returns the updated entity.
// Only fields where IsSet() is true are included in the SET clause. If no fields are
// set, no UPDATE is executed and the current entity is returned unchanged.
{{- if .StrictUpdates }}
// Returns ErrNotFound if the primary key does not exist (strict_updates is enabled).
{{- end }}
func (c *{{ $structCamel }}Client) Update(ctx context.Context, {{ if .CompositePK }}pk {{ .CompositePKStructName }}{{ else }}id {{ $pkCol.GoType }}{{ end }}, input *Update{{ .StructName }}Input, opts ...func(*CallOptions[{{ .StructName }}FieldOptions])) (*{{ .StructName }}, error) {
	// Nil is a caller error, distinct from an empty-but-non-nil
	// input — that one is the documented no-op returning the entity unchanged.
	// Guarded before the executor, so nil fires no hook and publishes no event.
	if input == nil {
		return nil, ErrNilInput
	}
	options := resolveCallOptions(opts)
	result, err := c.executeMutation(ctx, options.SkipHooks, &hook.MutationContext{
		Op: hook.OpUpdate, Table: {{ .TableNameConstant }}, Schema: {{ printf "%q" .Schema }},
		PK: {{ if .CompositePK }}pk{{ else }}id{{ end }}, Input: input, CallOptions: options,
	}, func(ctx context.Context, m *hook.MutationContext) (any, error) {
		conn := database.Conn(ctx, c.querier)
{{- if and .Tenancy .Tenancy.Tenanted }}

		// Tenancy mismatch check before any SQL build. applyTenancy
		// is false under SkipTenancy OR under required:false + zero resolver —
		// in the second case the WHERE below also drops the tenant predicate.
		var resolvedTenant {{ .Tenancy.GoType }}
		applyTenancy := false
		if !options.SkipTenancy {
			var err error
			var apply bool
			resolvedTenant, apply, err = c.resolveTenant(ctx, options.Tenant)
			if err != nil {
				return nil, fmt.Errorf("update {{ $singular }}: resolve tenant: %w", err)
			}
			// Stash on ctx so the chained terminal Get reuses this value
			// — single-resolve.
			// An explicit tenant is not cached: it rides on CallOptions, which
			// every internal call inherits, and resolveTenant honours it ahead of
			// the cache. A set zero is honoured verbatim where a resolved
			// zero takes the required branch, and this slot cannot tell them apart.
			if options.Tenant == nil {
				ctx = tenancy.WithResolvedTenant(ctx, resolvedTenant)
			}
			applyTenancy = apply
			if apply {
{{- if and .Tenancy.InPrimaryKey .CompositePK }}
				// Tenant-in-PK verify-match. The tenant column is part of
				// the composite primary key on {{ .CompositePKStructName }}; the caller supplies
				// it explicitly, and we reject any mismatch before the DB round-trip.
				// No input-side check — tenant column is excluded from UpdateInput when
				// it lives in the PK.
				if pk.{{ .Tenancy.FieldName }} != resolvedTenant {
					return nil, tenancy.ErrMismatch
				}
{{- else }}
				if v, ok := input.{{ .Tenancy.FieldName }}.Get(); ok && v != resolvedTenant {
					return nil, tenancy.ErrMismatch
				}
{{- end }}
				// Stash for cache hook (single-resolve per operation).
				m.Tenant = resolvedTenant
			}
		}
{{- end }}

		// Build SET clause from omittable fields — explicit per-field checks, no reflection
		setClauses := make(map[string]any)
{{- range .UpdateInputFields }}
{{- if and $.Tenancy $.Tenancy.Tenanted (eq .ColumnName $.Tenancy.Column) }}
		// Tenant column excluded from SET under normal operation.
		// Honored when the caller opted out via SkipTenancy OR when
		// required:false + zero resolver opted out of tenancy for this call.
		if !applyTenancy {
			if v, ok := input.{{ .FieldName }}.Get(); ok {
				setClauses[{{ printf "%q" .ColumnName }}] = v
			}
		}
{{- else }}
		if v, ok := input.{{ .FieldName }}.Get(); ok {
			setClauses[{{ printf "%q" .ColumnName }}] = v
		}
{{- end }}
{{- end }}

		// Empty update — no fields set, return current entity unchanged
		if len(setClauses) == 0 {
			// Empty FieldOptions — caller doesn't need the result
			if options.FieldOptions != nil && !options.FieldOptions.HasSelectedColumns() {
				return nil, nil
			}

			return c.Get(ctx, {{ if .CompositePK }}pk{{ else }}id{{ end }}, func(o *CallOptions[{{ .StructName }}FieldOptions]) {
				*o = options
				o.SkipHooks = true
				o.LockMode = sql.LockNone
			})
		}
{{- range .UpdateColumns }}

		// Auto-set {{ .Name }} to current time if not explicitly provided
		if _, ok := input.{{ .FieldName }}.Get(); !ok {
			setClauses[{{ printf "%q" .Name }}] = time.Now()
		}
{{- end }}

{{- if and .Tenancy .Tenancy.Tenanted }}
{{- if .CompositePK }}
		updateConds := sql.BuildCompositePKConditions(c.dialect,
			[]string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} },
			[]any{ {{- range .PKColumns }}pk.{{ .FieldName }}, {{ end -}} })
{{- else }}
		updateConds := []sql.Condition{sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" $pkCol.Name }})).Eq(id)}
{{- end }}
		if applyTenancy {
			updateConds = append(updateConds, sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" .Tenancy.Column }})).Eq(resolvedTenant))
		}
{{- if and $captureTenant (not (supportsReturning)) }}

		// MySQL has no RETURNING — pre-read the row's tenant before the UPDATE
		// so cache invalidation and event stamping can rebuild the tenant-scoped
		// key from the row itself, independent of how (or whether) the tenant
		// was resolved.
		tenantByPK, err := c.captureAffectedTenants(ctx, conn, updateConds)
		if err != nil {
			return nil, fmt.Errorf("update {{ $singular }}: capture tenant: %w", err)
		}
		capturedTenant := tenantByPK[{{ if .CompositePK }}pk{{ else }}id{{ end }}]
{{- end }}

{{- if and $captureTenant (supportsReturning) }}

		// RETURNING the tenant column captures the row's own tenant so cache
		// invalidation and event stamping can rebuild the tenant-scoped key,
		// independent of how (or whether) the tenant was resolved.
		query, args := sql.BuildUpdate(c.dialect, c.table, sql.UpdateOptions{
			SetClauses:       setClauses,
			Conditions:       updateConds,
			ReturningColumns: []string{ {{- printf "%q" .Tenancy.Column -}} },
		})
{{- else }}

		query, args := sql.BuildUpdate(c.dialect, c.table, sql.UpdateOptions{
			SetClauses: setClauses,
			Conditions: updateConds,
		})
{{- end }}
{{- else }}

		query, args := sql.BuildUpdate(c.dialect, c.table, sql.UpdateOptions{
			SetClauses: setClauses,
{{- if .CompositePK }}
			Conditions: sql.BuildCompositePKConditions(c.dialect,
				[]string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} },
				[]any{ {{- range .PKColumns }}pk.{{ .FieldName }}, {{ end -}} }),
{{- else }}
			Conditions: []sql.Condition{sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" $pkCol.Name }})).Eq({{ if .CompositePK }}pk{{ else }}id{{ end }})},
{{- end }}
		})
{{- end }}
{{- if and $captureTenant (supportsReturning) }}

		rows, err := conn.Query(ctx, query, args...)
		if err != nil {
			return nil, fmt.Errorf("update {{ $singular }}: %w", err)
		}
		var capturedTenant any
{{- if .StrictUpdates }}
		matched := 0
{{- end }}
		for rows.Next() {
			var rowTenant {{ .Tenancy.GoType }}
			if err := rows.Scan(&rowTenant); err != nil {
				rows.Close()
				return nil, fmt.Errorf("scan updated {{ $singular }} tenant: %w", err)
			}
			capturedTenant = rowTenant
{{- if .StrictUpdates }}
			matched++
{{- end }}
		}
		if err := rows.Err(); err != nil {
			rows.Close()
			return nil, err
		}
		rows.Close()
{{- if .StrictUpdates }}
		if matched == 0 {
			return nil, ErrNotFound
		}
{{- end }}
{{- else }}

		execResult, err := conn.Exec(ctx, query, args...)
		if err != nil {
			return nil, fmt.Errorf("update {{ $singular }}: %w", err)
		}
{{- if .StrictUpdates }}
		count, err := execResult.RowsAffected()
		if err != nil {
			return nil, fmt.Errorf("update {{ $singular }} rows affected: %w", err)
		}
		if count == 0 {
			return nil, ErrNotFound
		}
{{- else }}
		_ = execResult
{{- end }}
{{- end }}
		m.AffectedPKs = []any{ {{ if .CompositePK }}pk{{ else }}id{{ end }} }
{{- if $captureTenant }}
		m.AffectedTenants = []any{capturedTenant}
{{- end }}

		// Empty FieldOptions — caller doesn't need the result
		if options.FieldOptions != nil && !options.FieldOptions.HasSelectedColumns() {
			return nil, nil
		}

		return c.Get(ctx, {{ if .CompositePK }}pk{{ else }}id{{ end }}, func(o *CallOptions[{{ .StructName }}FieldOptions]) {
			*o = options
			o.SkipHooks = true
			o.LockMode = sql.LockNone
		})
	})
	if err != nil {
		return nil, err
	}
	if result == nil {
		return nil, nil
	}
	return result.(*{{ .StructName }}), nil
}
{{- end }}
{{- if .Operations.UpdateMany }}

// Update{{ .StructName }}Item pairs a primary key with an update input for batch updates.
type Update{{ .StructName }}Item struct {
{{- if .CompositePK }}
	PK    {{ .CompositePKStructName }}    `json:"pk"`
	Input *Update{{ .StructName }}Input `json:"input"`
{{- else }}
	{{ $pkCol.FieldName }} {{ $pkCol.GoType }} `json:"{{ $pkCol.JSONTag }}"`
	Input *Update{{ .StructName }}Input `json:"input"`
{{- end }}
}

// UpdateMany partially updates multiple {{ .TableName }} and returns the updated entities.
// Each item is a (PK, UpdateInput) pair. Splits into batches of batchSize.
{{- if eq .Driver "stdlib" }}
// On stdlib, each UPDATE executes sequentially.
{{- else }}
// On pgx, uses SendBatch for pipelined execution within each batch.
{{- end }}
func (c *{{ $structCamel }}Client) UpdateMany(ctx context.Context, items []Update{{ .StructName }}Item, opts ...func(*CallOptions[{{ .StructName }}FieldOptions])) ([]*{{ .StructName }}, error) {
	// Update{{ .StructName }}Item.Input is a pointer, so a zero-valued item
	// carries a nil one — a shape that compiles naturally. Rejected before the
	// executor, like every other nil write input.
	for _, item := range items {
		if item.Input == nil {
			return nil, ErrNilInput
		}
	}
	options := resolveCallOptions(opts)
	result, err := c.executeMutation(ctx, options.SkipHooks, &hook.MutationContext{
		Op: hook.OpUpdateMany, Table: {{ .TableNameConstant }}, Schema: {{ printf "%q" .Schema }},
		Input: items, CallOptions: options,
	}, func(ctx context.Context, m *hook.MutationContext) (any, error) {
		conn := database.Conn(ctx, c.querier)
		// An empty batch writes nothing and must read nothing. The trailing
		// re-fetch below filters on the keys this call touched, and every
		// generated key filter treats an empty set as *no condition* — so
		// without this guard the re-fetch degrades to an unfiltered SELECT and
		// returns the whole table as if this call had produced it.
		if len(items) == 0 {
			return []*{{ .StructName }}{}, nil
		}
{{- if and .Tenancy .Tenancy.Tenanted }}

		// Resolve the tenant once; per-item mismatch checks use the same value.
		// applyTenancy=false under SkipTenancy OR under required:false + zero
		// resolver — the per-item verify-match and per-row WHERE both drop.
		var resolvedTenant {{ .Tenancy.GoType }}
		applyTenancy := false
		if !options.SkipTenancy {
			var err error
			var apply bool
			resolvedTenant, apply, err = c.resolveTenant(ctx, options.Tenant)
			if err != nil {
				return nil, fmt.Errorf("update {{ .TableName }}: resolve tenant: %w", err)
			}
			// Stash on ctx so the per-item verify-match short-circuits via the
			// cache and the chained terminal GetMany reuses this value
			// — single-resolve.
			// An explicit tenant is not cached: it rides on CallOptions, which
			// every internal call inherits, and resolveTenant honours it ahead of
			// the cache. A set zero is honoured verbatim where a resolved
			// zero takes the required branch, and this slot cannot tell them apart.
			if options.Tenant == nil {
				ctx = tenancy.WithResolvedTenant(ctx, resolvedTenant)
			}
			applyTenancy = apply
			if apply {
				for _, item := range items {
{{- if and .Tenancy.InPrimaryKey .CompositePK }}
					// Tenant-in-PK verify-match per item in the batch.
					// No input-side check — tenant column excluded from UpdateInput
					// when it lives in the PK.
					if item.PK.{{ .Tenancy.FieldName }} != resolvedTenant {
						return nil, tenancy.ErrMismatch
					}
{{- else }}
					if v, ok := item.Input.{{ .Tenancy.FieldName }}.Get(); ok && v != resolvedTenant {
						return nil, tenancy.ErrMismatch
					}
{{- end }}
				}
				// Stash for cache hook (single-resolve per operation).
				m.Tenant = resolvedTenant
			}
		}
{{- end }}

{{- if .CompositePK }}
		var allPKs []{{ .CompositePKStructName }}
{{- else }}
		var allIDs []{{ $pkCol.GoType }}
{{- end }}
{{- if and $captureTenant (supportsReturning) }}
		// Per-item RETURNING captures each updated row's tenant; feeds
		// m.AffectedTenants so cache invalidation and event stamping rebuild
		// tenant-scoped keys from the rows themselves.
		tenantByPK := make(map[{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}]any, len(items))
{{- else if $captureTenant }}
		// MySQL has no RETURNING — one batched pre-read captures every item's
		// tenant before the per-item UPDATE loop.
		tenantByPK := make(map[{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}]any, len(items))
		if len(items) > 0 {
			itemPKs := make([]{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}, 0, len(items))
			for _, item := range items {
				itemPKs = append(itemPKs, {{ if .CompositePK }}item.PK{{ else }}item.{{ $pkCol.FieldName }}{{ end }})
			}
{{- if .CompositePK }}
			preValues := make([][]any, len(itemPKs))
			for i, pk := range itemPKs {
				preValues[i] = []any{ {{- range .PKColumns }}pk.{{ .FieldName }}, {{ end -}} }
			}
			preConds := []sql.Condition{
				sql.BuildCompositePKBatchCondition(c.dialect, []string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} }, preValues),
			}
{{- else }}
			preConds := []sql.Condition{sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" $pkCol.Name }})).In(toAnySlice(itemPKs)...)}
{{- end }}
			if applyTenancy {
				preConds = append(preConds, sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" .Tenancy.Column }})).Eq(resolvedTenant))
			}
			var err error
			tenantByPK, err = c.captureAffectedTenants(ctx, conn, preConds)
			if err != nil {
				return nil, fmt.Errorf("update {{ .TableName }}: capture tenants: %w", err)
			}
		}
{{- end }}
		for start := 0; start < len(items); start += c.batchSize {
			end := min(start+c.batchSize, len(items))
			batch := items[start:end]
{{- if eq .Driver "pgx" }}

			// Build all UPDATE statements for this batch
			pgxBatch := &pgx.Batch{}
			var batchQueries []string
			var batchArgs [][]any
{{- if $captureTenant }}
			var queuedPKs []{{ if .CompositePK }}{{ .CompositePKStructName }}{{ else }}{{ $pkCol.GoType }}{{ end }}
{{- end }}
			for _, item := range batch {
				setClauses := make(map[string]any)
{{- range .UpdateInputFields }}
{{- if and $.Tenancy $.Tenancy.Tenanted (eq .ColumnName $.Tenancy.Column) }}
				if !applyTenancy {
					if v, ok := item.Input.{{ .FieldName }}.Get(); ok {
						setClauses[{{ printf "%q" .ColumnName }}] = v
					}
				}
{{- else }}
				if v, ok := item.Input.{{ .FieldName }}.Get(); ok {
					setClauses[{{ printf "%q" .ColumnName }}] = v
				}
{{- end }}
{{- end }}

				// Skip no-op updates
				if len(setClauses) == 0 {
{{- if .CompositePK }}
					allPKs = append(allPKs, item.PK)
{{- else }}
					allIDs = append(allIDs, item.{{ $pkCol.FieldName }})
{{- end }}
					continue
				}
{{- range .UpdateColumns }}

				// Auto-set {{ .Name }} to current time if not explicitly provided
				if _, ok := item.Input.{{ .FieldName }}.Get(); !ok {
					setClauses[{{ printf "%q" .Name }}] = time.Now()
				}
{{- end }}

{{- if and .Tenancy .Tenancy.Tenanted }}
{{- if .CompositePK }}
				itemConds := sql.BuildCompositePKConditions(c.dialect,
					[]string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} },
					[]any{ {{- range .PKColumns }}item.PK.{{ .FieldName }}, {{ end -}} })
{{- else }}
				itemConds := []sql.Condition{sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" $pkCol.Name }})).Eq(item.{{ $pkCol.FieldName }})}
{{- end }}
				if applyTenancy {
					itemConds = append(itemConds, sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" .Tenancy.Column }})).Eq(resolvedTenant))
				}
{{- if and $captureTenant (supportsReturning) }}
				query, args := sql.BuildUpdate(c.dialect, c.table, sql.UpdateOptions{
					SetClauses:       setClauses,
					Conditions:       itemConds,
					ReturningColumns: []string{ {{- printf "%q" .Tenancy.Column -}} },
				})
{{- else }}
				query, args := sql.BuildUpdate(c.dialect, c.table, sql.UpdateOptions{
					SetClauses: setClauses,
					Conditions: itemConds,
				})
{{- end }}
{{- else }}

				query, args := sql.BuildUpdate(c.dialect, c.table, sql.UpdateOptions{
					SetClauses: setClauses,
{{- if .CompositePK }}
					Conditions: sql.BuildCompositePKConditions(c.dialect,
						[]string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} },
						[]any{ {{- range .PKColumns }}item.PK.{{ .FieldName }}, {{ end -}} }),
{{- else }}
					Conditions: []sql.Condition{sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" $pkCol.Name }})).Eq(item.{{ $pkCol.FieldName }})},
{{- end }}
				})
{{- end }}
				pgxBatch.Queue(query, args...)
				batchQueries = append(batchQueries, query)
				batchArgs = append(batchArgs, args)
{{- if $captureTenant }}
				queuedPKs = append(queuedPKs, {{ if .CompositePK }}item.PK{{ else }}item.{{ $pkCol.FieldName }}{{ end }})
{{- end }}
{{- if .CompositePK }}
				allPKs = append(allPKs, item.PK)
{{- else }}
				allIDs = append(allIDs, item.{{ $pkCol.FieldName }})
{{- end }}
			}

{{- if $captureTenant }}

			// Send all UPDATEs — pipelined if supported, sequential otherwise.
			// Each statement RETURNING-projects the row's tenant; the scan
			// below captures it per queued PK.
			if pgxBatch.Len() > 0 {
				if batcher, ok := conn.(interface {
					SendBatch(ctx context.Context, b *pgx.Batch) pgx.BatchResults
				}); ok {
					br := batcher.SendBatch(ctx, pgxBatch)
					for i := range pgxBatch.Len() {
						rows, err := br.Query()
						if err != nil {
							br.Close()
							return nil, fmt.Errorf("update {{ .TableName }} batch: %w", err)
						}
						for rows.Next() {
							var rowTenant {{ .Tenancy.GoType }}
							if err := rows.Scan(&rowTenant); err != nil {
								rows.Close()
								br.Close()
								return nil, fmt.Errorf("scan updated {{ $singular }} tenant: %w", err)
							}
							tenantByPK[queuedPKs[i]] = rowTenant
						}
						if err := rows.Err(); err != nil {
							br.Close()
							return nil, fmt.Errorf("update {{ .TableName }} batch: %w", err)
						}
						rows.Close()
					}
					if err := br.Close(); err != nil {
						return nil, fmt.Errorf("close update batch: %w", err)
					}
				} else {
					for i, q := range batchQueries {
						rows, err := conn.Query(ctx, q, batchArgs[i]...)
						if err != nil {
							return nil, fmt.Errorf("update {{ .TableName }} batch: %w", err)
						}
						for rows.Next() {
							var rowTenant {{ .Tenancy.GoType }}
							if err := rows.Scan(&rowTenant); err != nil {
								rows.Close()
								return nil, fmt.Errorf("scan updated {{ $singular }} tenant: %w", err)
							}
							tenantByPK[queuedPKs[i]] = rowTenant
						}
						if err := rows.Err(); err != nil {
							rows.Close()
							return nil, fmt.Errorf("update {{ .TableName }} batch: %w", err)
						}
						rows.Close()
					}
				}
			}
{{- else }}

			// Send all UPDATEs — pipelined if supported, sequential otherwise
			if pgxBatch.Len() > 0 {
				if batcher, ok := conn.(interface {
					SendBatch(ctx context.Context, b *pgx.Batch) pgx.BatchResults
				}); ok {
					br := batcher.SendBatch(ctx, pgxBatch)
					for range pgxBatch.Len() {
						if _, err := br.Exec(); err != nil {
							br.Close()
							return nil, fmt.Errorf("update {{ .TableName }} batch: %w", err)
						}
					}
					if err := br.Close(); err != nil {
						return nil, fmt.Errorf("close update batch: %w", err)
					}
				} else {
					for i, q := range batchQueries {
						if _, err := conn.Exec(ctx, q, batchArgs[i]...); err != nil {
							return nil, fmt.Errorf("update {{ .TableName }} batch: %w", err)
						}
					}
				}
			}
{{- end }}
{{- else }}

			for _, item := range batch {
				setClauses := make(map[string]any)
{{- range .UpdateInputFields }}
{{- if and $.Tenancy $.Tenancy.Tenanted (eq .ColumnName $.Tenancy.Column) }}
				if !applyTenancy {
					if v, ok := item.Input.{{ .FieldName }}.Get(); ok {
						setClauses[{{ printf "%q" .ColumnName }}] = v
					}
				}
{{- else }}
				if v, ok := item.Input.{{ .FieldName }}.Get(); ok {
					setClauses[{{ printf "%q" .ColumnName }}] = v
				}
{{- end }}
{{- end }}

				// Skip no-op updates
				if len(setClauses) == 0 {
{{- if .CompositePK }}
					allPKs = append(allPKs, item.PK)
{{- else }}
					allIDs = append(allIDs, item.{{ $pkCol.FieldName }})
{{- end }}
					continue
				}
{{- range .UpdateColumns }}

				// Auto-set {{ .Name }} to current time if not explicitly provided
				if _, ok := item.Input.{{ .FieldName }}.Get(); !ok {
					setClauses[{{ printf "%q" .Name }}] = time.Now()
				}
{{- end }}

{{- if and .Tenancy .Tenancy.Tenanted }}
{{- if .CompositePK }}
				itemConds := sql.BuildCompositePKConditions(c.dialect,
					[]string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} },
					[]any{ {{- range .PKColumns }}item.PK.{{ .FieldName }}, {{ end -}} })
{{- else }}
				itemConds := []sql.Condition{sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" $pkCol.Name }})).Eq(item.{{ $pkCol.FieldName }})}
{{- end }}
				if applyTenancy {
					itemConds = append(itemConds, sql.Where(c.dialect.QuoteIdentifier({{ printf "%q" .Tenancy.Column }})).Eq(resolvedTenant))
				}
{{- if and $captureTenant (supportsReturning) }}
