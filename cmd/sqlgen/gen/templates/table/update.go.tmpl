// collectAffectedPKs returns the composite PKs of rows matching the conditions.
// Used by Where variants to know which rows were affected.
func (c *{{ $structCamel }}Client) collectAffectedPKs(ctx context.Context, conn database.Querier, conds []sql.Condition) ([]{{ .CompositePKStructName }}, error) {
	query, args := sql.BuildSelect(c.dialect, c.table, sql.SelectOptions{
		Columns:    []string{ {{- range .PKColumns }}{{ printf "%q" .Name }}, {{ end -}} },
		Conditions: conds,
	})

	rows, err := conn.Query(ctx, query, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	var pks []{{ .CompositePKStructName }}
	for rows.Next() {
		var pk {{ .CompositePKStructName }}
		if err := rows.Scan({{ range $i, $col := .PKColumns }}{{ if $i }}, {{ end }}&pk.{{ $col.FieldName }}{{ end }}); err != nil {
			return nil, err
		}
		pks = append(pks, pk)
	}
	return pks, rows.Err()
}
