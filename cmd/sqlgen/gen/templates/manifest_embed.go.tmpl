{{- define "manifest-embed" -}}
//go:embed {{ .EmbedJSONPath }}
{{- if .PerEntity }}
//go:embed all:{{ .EmbedEntitiesPath }}
{{- end }}
var sqlgenManifestFS embed.FS

var (
	sqlgenManifestDoc      manifest.Document
	sqlgenManifestEntities = map[string]*manifest.Entity{}
	sqlgenManifestVersion  string
)

func init() {
	raw, err := sqlgenManifestFS.ReadFile("{{ .EmbedJSONPath }}")
	if err != nil {
		panic(err)
	}

	var entityFS fs.FS
{{- if .PerEntity }}
	sub, err := fs.Sub(sqlgenManifestFS, "{{ .EmbedEntitiesPath }}")
	if err != nil {
		panic(err)
	}
	entityFS = sub
{{- end }}

	if err := manifest.LoadInto(raw, entityFS, &sqlgenManifestDoc, sqlgenManifestEntities); err != nil {
		panic(err)
	}
	sqlgenManifestVersion = sqlgenManifestDoc.SchemaVersion
}

// Manifest returns the parsed manifest document. It is pre-parsed at package
// init and safe for concurrent reads. The document's Entities slice is the
// lightweight index form; use ManifestEntity for full entity records — the
// lookup is layout-agnostic.
func (c *Client) Manifest() *manifest.Document {
	return &sqlgenManifestDoc
}

// ManifestEntity returns the full record for the given table, identically
// across the single and per_entity disk layouts. Name a table with a schema as
// schema.table, or by its bare name when no other schema has a table of that
// name. It returns (nil, manifest.ErrEntityNotFound) for unknown tables, and nil
// with an error wrapping manifest.ErrEntityNotFound for a bare name that
// several schemas share.
func (c *Client) ManifestEntity(table string) (*manifest.Entity, error) {
	return manifest.FindEntity(sqlgenManifestEntities, table)
}

// ManifestVersion returns the manifest schema_version string, pre-extracted at
// init for cheap drift detection without walking the full document.
func (c *Client) ManifestVersion() string {
	return sqlgenManifestVersion
}
{{- end -}}
